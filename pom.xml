<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- O parent do Spring Boot gerencia as versões das dependências (Tomcat, Jackson, JUnit, Mockito...)
         e já configura encoding UTF-8, compilação com -parameters e o plugin de empacotamento. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>br.com.minispring</groupId>
    <artifactId>livros-api</artifactId>
    <version>2.0.0</version>
    <name>livros-api</name>
    <description>API de Catálogo de Livros - Grupo 6 (migrada do Mini Spring para Spring Boot)</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Spring MVC + Jackson + Tomcat embutido: substitui o Jetty, o DispatcherServlet,
             o Router e o ObjectMapper que o Mini Spring montava manualmente. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Bean Validation (Hibernate Validator): @NotBlank, @Positive, @Valid. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- JUnit 5, Mockito, MockMvc e @SpringBootTest. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Gera o "fat JAR" executável (substitui o maven-shade-plugin) e habilita mvn spring-boot:run. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
